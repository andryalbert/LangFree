<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margin_normal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="@dimen/margin_large" />

        <!-- Niveau -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/level"
            android:textSize="@dimen/text_size_normal"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/margin_small" />

        <Spinner
            android:id="@+id/levelSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_min_height"
            android:background="@android:drawable/btn_dropdown"
            android:layout_marginBottom="@dimen/margin_large" />

        <!-- Langue des explications -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/explanation_language"
            android:textSize="@dimen/text_size_normal"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/margin_small" />

        <Spinner
            android:id="@+id/explanationLanguageSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_min_height"
            android:background="@android:drawable/btn_dropdown"
            android:layout_marginBottom="@dimen/margin_large" />

        <!-- Vitesse de la voix -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voice_speed"
            android:textSize="@dimen/text_size_normal"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/margin_small" />

        <SeekBar
            android:id="@+id/voiceSpeedSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20"
            android:progress="10"
            android:layout_marginBottom="@dimen/margin_large" />

        <!-- Délai de silence -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/silence_delay"
            android:textSize="@dimen/text_size_normal"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/margin_small" />

        <SeekBar
            android:id="@+id/silenceDelaySeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="9"
            android:progress="2"
            android:layout_marginBottom="@dimen/margin_small" />

        <TextView
            android:id="@+id/silenceDelayText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/seconds"
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/margin_large" />

        <!-- Sensibilité du micro -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mic_sensitivity"
            android:textSize="@dimen/text_size_normal"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/margin_small" />

        <Spinner
            android:id="@+id/micSensitivitySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_min_height"
            android:background="@android:drawable/btn_dropdown"
            android:layout_marginBottom="@dimen/margin_large" />

        <!-- Profil de modèle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/model_profile"
            android:textSize="@dimen/text_size_normal"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/margin_small" />

        <Spinner
            android:id="@+id/modelProfileSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_min_height"
            android:background="@android:drawable/btn_dropdown"
            android:layout_marginBottom="@dimen/margin_large" />

        <!-- Lire la correction -->
        <CheckBox
            android:id="@+id/readCorrectionCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/read_correction"
            android:textSize="@dimen/text_size_normal"
            android:checked="true"
            android:layout_marginBottom="@dimen/margin_large" />

        <!-- Effacer l'historique -->
        <Button
            android:id="@+id/clearHistoryButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_min_height"
            android:text="@string/clear_history"
            android:backgroundTint="@color/error"
            android:layout_marginBottom="@dimen/margin_large" />

        <!-- Carnet de vocabulaire -->
        <Button
            android:id="@+id/vocabularyButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_min_height"
            android:text="@string/vocabulary"
            android:backgroundTint="@color/primary"
            android:layout_marginBottom="@dimen/margin_large" />

        <!-- Retour -->
        <Button
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_min_height"
            android:text="Retour"
            android:backgroundTint="@color/text_secondary"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>

</ScrollView>
