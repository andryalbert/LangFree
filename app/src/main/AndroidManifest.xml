<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permission pour le micro -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <!-- Permission pour internet (téléchargement initial des modèles uniquement) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Permission pour stockage (import de fichiers existants) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    
    <!-- Permission pour écrire dans le stockage interne (pas besoin de permission) -->

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:name=".LangFreeApp"
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_help"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/ic_menu_help"
        android:supportsRtl="true"
        android:theme="@style/Theme.LangFree"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.LangFree">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".InstallationActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.LangFree" />
        
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.LangFree" />
        
        <!-- Service pour le TTS en arrière-plan si besoin -->
        <service
            android:name=".speech.AnaSpeaker"
            android:exported="false" />

    </application>

</manifest>
